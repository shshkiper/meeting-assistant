# ======================
# MeetingAssistant .env
# ======================

# App
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key-in-production
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://meetinguser:meetingpass@postgres:5432/meetingdb

# Redis (Celery broker + cache)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO (file storage)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_AUDIO=meeting-audio
MINIO_BUCKET_DOCS=meeting-docs
MINIO_SECURE=false

# Whisper (transcription)
WHISPER_MODEL=large-v3          # tiny/base/small/medium/large-v3
WHISPER_DEVICE=cpu              # cpu / cuda
WHISPER_LANGUAGE=ru             # auto or explicit

# LLM (for summary/protocol generation)
# On-premise: Ollama or OpenAI-compatible endpoint
LLM_PROVIDER=ollama             # ollama | openai | anthropic
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.1:8b           # or mistral, etc.
LLM_API_KEY=                    # required for openai/anthropic

# CORS (allowed origins for frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# JWT Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Corporate LDAP/AD (optional)
LDAP_ENABLED=false
LDAP_SERVER=ldap://ldap.bank.local
LDAP_BASE_DN=dc=bank,dc=local
LDAP_BIND_DN=cn=svc_meeting,dc=bank,dc=local
LDAP_BIND_PASSWORD=

# Task Integration (optional)
JIRA_ENABLED=false
JIRA_URL=https://jira.bank.local
JIRA_TOKEN=
JIRA_PROJECT_KEY=MTG

# Logging
LOG_LEVEL=INFO
